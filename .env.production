# Agentic Coding System Environment Configuration
# Copy this file to .env and fill in your values

# Core Settings
ACS_ENVIRONMENT=development
ACS_DEBUG=false
ACS_PROJECT_NAME="Agentic Coding System"
ACS_VERSION=0.1.0

# API Configuration
# Get your API key from: https://console.anthropic.com/
# Anthropic API key only used for fallback
ACS_API__KEY="Anthropi_API_key_here"
ACS_API__BASE_URL=https://api.anthropic.com
ACS_API__TIMEOUT=300
ACS_API__MAX_RETRIES=3
ACS_API__RATE_LIMIT_PER_MINUTE=50

# Agent Configuration
ACS_AGENT__MAX_PARALLEL_AGENTS=10
ACS_AGENT__USE_OPENAI_FOR_META_AGENT=true
ACS_AGENT__DEFAULT_MODEL=claude-3-5-sonnet-latest
ACS_AGENT__META_AGENT_MODEL=claude-3-5-opus-latest
ACS_AGENT__VERIFICATION_TIMEOUT=600
ACS_AGENT__MAX_REPAIR_ATTEMPTS=5
ACS_AGENT__CONTEXT_WINDOW_BUFFER=1000

# OpenAI Configuration (for Meta Agent when enabled)
ACS_OPENAI__KEY="OpenAI_API_key_here"
ACS_OPENAI__MODEL=gpt-4-turbo-preview
ACS_OPENAI__META_AGENT_MODEL=o3
ACS_OPENAI__TIMEOUT=300
ACS_OPENAI__MAX_RETRIES=3

# Verification Settings
ACS_VERIFICATION__ENABLE_COMPILATION_CHECK=true
ACS_VERIFICATION__ENABLE_TEST_VERIFICATION=true
ACS_VERIFICATION__MINIMUM_COVERAGE=90.0
ACS_VERIFICATION__STRICT_MODE=true

# Learning System
ACS_LEARNING__ENABLE_LEARNING=true
ACS_LEARNING__PATTERN_THRESHOLD=3
ACS_LEARNING__MEMORY_RETENTION_DAYS=30
ACS_LEARNING__IMPROVEMENT_THRESHOLD=0.1

# Storage Configuration
ACS_STORAGE__BASE_PATH=./artifacts
ACS_STORAGE__MAX_VERSIONS=10
ACS_STORAGE__ENABLE_COMPRESSION=true
ACS_STORAGE__CLEANUP_INTERVAL_HOURS=24

# Logging Configuration
ACS_LOGGING__LEVEL=INFO
ACS_LOGGING__FORMAT=json
ACS_LOGGING__FILE_PATH=./logs/agentic_system.log
ACS_LOGGING__MAX_FILE_SIZE_MB=100
ACS_LOGGING__BACKUP_COUNT=5
ACS_LOGGING__INCLUDE_TIMESTAMPS=true
ACS_LOGGING__INCLUDE_CONTEXT=true

# Performance Settings
ACS_ENABLE_PROFILING=false
ACS_ENABLE_METRICS=true
ACS_METRICS_PORT=9090

# Additional Configuration Files (optional)
# You can override settings using YAML files in the config directory:
# - config/settings.yaml (default settings)
# - config/settings.development.yaml (development overrides)
# - config/settings.production.yaml (production overrides)